---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import Education from '../components/Education.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/portfolio';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  description: site.description,
  url: Astro.site?.toString(),
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Riga Technical University' },
  address: { '@type': 'PostalAddress', addressLocality: 'Riga', addressCountry: 'LV' },
  // LinkedIn is deliberately not listed here until its address has been confirmed.
  sameAs: [site.github],
};
---

<BaseLayout title={`${site.name} · ${site.shortTitle}, applied ML & AI systems`} jsonLd={jsonLd}>
  <Hero />
  <About />
  <Skills />
  <Projects />
  <Education />
  <Contact />
</BaseLayout>
