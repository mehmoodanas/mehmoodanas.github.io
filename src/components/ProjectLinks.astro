---
import Icon from './Icon.astro';
import type { LinkItem } from '../data/types';

interface Props {
  links: LinkItem[];
  /** Project name, added for screen readers so identical labels stay distinguishable. */
  title?: string;
  /** "button" = outlined buttons, "link" = quiet text links (used inside cards). */
  variant?: 'button' | 'link';
  small?: boolean;
}
const { links, title, variant = 'button', small = false } = Astro.props;
---

{
  links.map((link) => (
    <a
      class:list={[variant === 'link' ? 'text-link' : 'btn', { 'btn--sm': small && variant === 'button' }]}
      href={link.href}
      target="_blank"
      rel="noopener noreferrer"
    >
      <Icon name={link.kind === 'repo' ? 'github' : 'external'} size={small ? 16 : 18} />
      {link.label}
      <span class="visually-hidden">
        {title ? ` for ${title}` : ''} (opens in a new tab)
      </span>
    </a>
  ))
}
