---
import SectionHeading from './SectionHeading.astro';
import { skills } from '../data/portfolio';
---

<section id="skills" class="section section--tint" aria-labelledby="skills-title">
  <div class="container">
    <SectionHeading
      id="skills-title"
      eyebrow="Skills"
      title="Tools from my studies and projects"
      lead="Grouped by the kind of work they support. Each card says where the skills come from."
    />

    <ul class="grid">
      {
        skills.map((group, index) => (
          <li class="card group reveal" style={`--i: ${index % 3}`}>
            <h3>{group.title}</h3>
            <ul class="chip-list">
              {group.items.map((item) => (
                <li class="chip">{item}</li>
              ))}
            </ul>
            {group.evidence && <p class="evidence">Source: {group.evidence}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.1rem;
  }
  .group {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.5rem;
  }
  .evidence {
    margin-top: auto;
    padding-top: 0.25rem;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
