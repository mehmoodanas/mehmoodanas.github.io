---
import Icon from './Icon.astro';
import Hero3D from './Hero3D.astro';
import { hero, site } from '../data/portfolio';
import { url } from '../utils/url';
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="container grid">
    <div class="copy">
      <p class="eyebrow">{site.location}</p>
      <h1 id="hero-title">
        <span class="greet">{hero.greeting}</span>
        {site.name}
      </h1>
      <p class="role">{site.title}</p>
      <p class="intro">{hero.intro}</p>

      <div class="actions">
        <a class="btn btn--primary" href={url('/#projects')}>
          View Projects
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn" href={url(site.cv.href)} download={site.cv.downloadName}>
          <Icon name="download" size={18} />
          Download CV
        </a>
        <a class="btn" href={url('/#contact')}>
          <Icon name="mail" size={18} />
          Contact
        </a>
      </div>

      <ul class="facts" aria-label="At a glance">
        {hero.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <div class="visual">
      <Hero3D />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2rem, 5vw, 3.5rem);
    overflow: clip;
  }
  /* Soft colour wash behind the decoration */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -10% -10% auto auto;
    width: min(60rem, 120vw);
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(14 107 120 / 0.11), transparent 70%) 70% 30% /
      70% 70% no-repeat;
    pointer-events: none;
  }

  .grid {
    display: grid;
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .greet {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--ink-3);
    font-size: 0.4em;
    font-weight: 550;
    letter-spacing: -0.01em;
  }

  .role {
    color: var(--accent-ink);
    font-size: clamp(1.1rem, 1.2vw + 0.8rem, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }

  .intro {
    max-width: 38rem;
    color: var(--ink-2);
    font-size: clamp(1.05rem, 0.5vw + 0.95rem, 1.2rem);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    margin-top: 0.75rem;
  }
  .facts li {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: rgb(255 255 255 / 0.7);
    color: var(--ink-2);
    font-size: 0.88rem;
    font-weight: 500;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    }
  }

  @media (max-width: 40rem) {
    .actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
