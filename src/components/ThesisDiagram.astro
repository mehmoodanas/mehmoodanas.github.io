---
/**
 * Schematic of the thesis system's components, taken from the CV description:
 * a Python/Flask ML inference micro-service, a Java/Spring Boot dialogue
 * backend and an HTML/JS front-end, all using REST APIs. It is a diagram, not a
 * screenshot, and deliberately does not show call directions or which model
 * runs where.
 */
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<figure class:list={['diagram', { compact }]}>
  <div class="parts" aria-hidden="true">
    <div class="part part--ml">
      <span class="lang">Python · Flask</span>
      <strong>ML inference micro-service</strong>
    </div>
    <div class="part">
      <span class="lang">Java · Spring Boot</span>
      <strong>Dialogue backend</strong>
    </div>
    <div class="part">
      <span class="lang">HTML / JavaScript</span>
      <strong>Front-end</strong>
    </div>
  </div>
  <div class="rest" aria-hidden="true"><span>REST APIs</span></div>
  <figcaption class="visually-hidden">
    Components of the thesis system: a Python Flask machine-learning inference micro-service, a
    Java Spring Boot dialogue backend and an HTML/JavaScript front-end, using REST APIs.
  </figcaption>
</figure>

<style>
  .diagram {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    background:
      radial-gradient(circle at 1px 1px, rgb(21 23 28 / 0.09) 1px, transparent 1.4px) 0 0 / 16px
        16px,
      linear-gradient(160deg, #ffffff, #efede8);
  }
  .parts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.7rem;
  }
  .part {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }
  .part strong {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .lang {
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .part--ml {
    border-color: rgb(var(--accent-rgb) / 0.5);
    background: linear-gradient(160deg, #fff, var(--accent-soft));
  }
  .rest {
    display: grid;
    place-items: center;
    padding: 0.45rem;
    border: 1px dashed var(--accent);
    border-radius: 999px;
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .parts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .compact .parts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
