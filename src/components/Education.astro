---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { certifications, education, projects } from '../data/portfolio';
import { url } from '../utils/url';

const thesisOf = (slug?: string) => projects.find((p) => p.slug === slug);
---

<section id="education" class="section section--tint" aria-labelledby="education-title">
  <div class="container">
    <SectionHeading
      id="education-title"
      eyebrow="Education"
      title="Education and certifications"
    />

    <div class="grid">
      {
        education.map((entry, index) => {
          const thesis = thesisOf(entry.thesisSlug);
          return (
            <article
              class="card degree reveal"
              aria-labelledby={`degree-title-${index}`}
            >
              <p class="period">{entry.period}</p>
              <h3 id={`degree-title-${index}`}>{entry.degree}</h3>
              <p class="school">
                {entry.institution} <span>· {entry.location}</span>
              </p>

              <h4 class="sub">Relevant coursework</h4>
              <ul class="chip-list">
                {entry.coursework.map((course) => (
                  <li class="chip">{course}</li>
                ))}
              </ul>

              {thesis && (
                <p class="thesis">
                  <strong>Thesis:</strong>{' '}
                  <a href={url(`/projects/${thesis.slug}`)}>{thesis.title}</a>
                </p>
              )}
            </article>
          );
        })
      }

      {
        certifications.length > 0 && (
          <section class="card panel reveal" style="--i: 1" aria-labelledby="certs-title">
            <h3 id="certs-title">Certifications</h3>
            <ul class="certs">
              {certifications.map((cert) => (
                <li>
                  <span class="badge">
                    <Icon name="award" size={18} />
                  </span>
                  <div>
                    <p class="cert-title">
                      {cert.url ? (
                        <a href={cert.url} target="_blank" rel="noopener noreferrer">
                          {cert.title}
                        </a>
                      ) : (
                        cert.title
                      )}
                    </p>
                    <p class="muted small">
                      {cert.issuer}
                      {cert.date && <> · {cert.date}</>}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: stretch;
  }

  .degree {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    box-shadow: var(--shadow-md);
  }
  .period {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .school {
    color: var(--ink);
    font-size: 1.1rem;
    font-weight: 550;
  }
  .school span {
    color: var(--ink-3);
    font-weight: 450;
  }
  .sub {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    letter-spacing: 0;
  }
  .thesis {
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .panel {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }
  .certs {
    display: grid;
    gap: 1rem;
  }
  .certs li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
  }
  .badge {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.75rem;
    background: var(--accent-soft);
    color: var(--accent-ink);
  }
  .cert-title {
    color: var(--ink);
    font-weight: 620;
    line-height: 1.35;
  }

  @media (min-width: 56rem) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }
  }
</style>
