---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { contact, site } from '../data/portfolio';
import { url } from '../utils/url';

// "https://github.com/name" -> "github.com/name", with a zero-width space after the slash
// so the address can wrap there (and never in the middle of the handle).
const display = (address: string) =>
  address.replace(/^https?:\/\/(www\.)?/, '').replace('/', '/​');
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <SectionHeading id="contact-title" eyebrow="Contact" title={contact.heading} lead={contact.text} />

    <div class="card panel reveal">
      <div class="main">
        <p class="label">Email</p>
        <a class="email" href={`mailto:${site.email}`}>{site.email}</a>

        <div class="actions">
          <a class="btn btn--primary" href={`mailto:${site.email}`}>
            <Icon name="mail" size={18} />
            Send an email
          </a>
          <button type="button" class="btn" data-copy={site.email}>
            <Icon name="copy" size={18} />
            <span data-copy-label>Copy email</span>
          </button>
        </div>
        <p class="visually-hidden" role="status" aria-live="polite" data-copy-status></p>
      </div>

      <ul class="links">
        <li>
          <a class="link-row" href={site.github} target="_blank" rel="noopener noreferrer">
            <span class="ico"><Icon name="github" size={20} /></span>
            <span>
              <span class="row-title">GitHub</span>
              <span class="row-sub">{display(site.github)}</span>
            </span>
            <Icon name="external" size={16} />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="link-row" href={site.linkedin} target="_blank" rel="noopener noreferrer">
            <span class="ico"><Icon name="linkedin" size={20} /></span>
            <span>
              <span class="row-title">LinkedIn</span>
              <span class="row-sub">{display(site.linkedin)}</span>
            </span>
            <Icon name="external" size={16} />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="link-row" href={url(site.cv.href)} download={site.cv.downloadName}>
            <span class="ico"><Icon name="download" size={20} /></span>
            <span>
              <span class="row-title">Download CV</span>
              <span class="row-sub">{site.cv.format} file</span>
            </span>
          </a>
        </li>
        <li>
          <p class="link-row static">
            <span class="ico"><Icon name="pin" size={20} /></span>
            <span>
              <span class="row-title">Location</span>
              <span class="row-sub">{site.location}</span>
            </span>
          </p>
        </li>
        {
          site.showPhone && (
            <li>
              <a class="link-row" href={`tel:${site.phone.replace(/\s/g, '')}`}>
                <span class="ico"><Icon name="phone" size={20} /></span>
                <span>
                  <span class="row-title">Phone</span>
                  <span class="row-sub">{site.phone}</span>
                </span>
              </a>
            </li>
          )
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.75rem);
    box-shadow: var(--shadow-lg);
  }
  .main {
    container-type: inline-size;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    justify-items: start;
  }
  .label {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  /* Sized from the width of its own column so the address always stays on one line. */
  .email {
    display: inline-block;
    max-width: 100%;
    padding-block: 0.65rem;
    color: var(--ink);
    font-size: 1.2rem;
    font-size: min(2rem, 6.4cqi);
    font-weight: 680;
    letter-spacing: -0.02em;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration-color: var(--accent);
  }
  .email:hover {
    color: var(--accent-ink);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .btn[data-copied] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-ink);
  }

  .links {
    display: grid;
    gap: 0.6rem;
  }
  .link-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    min-height: 3.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }
  a.link-row:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
  }
  @media (hover: hover) {
    a.link-row:hover {
      transform: translateX(3px);
    }
  }
  .link-row.static {
    grid-template-columns: auto minmax(0, 1fr);
  }
  .ico {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 0.7rem;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--accent-ink);
  }
  .row-title {
    display: block;
    font-weight: 620;
    line-height: 1.25;
  }
  .row-sub {
    display: block;
    color: var(--ink-3);
    font-size: 0.88rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 56rem) {
    .panel {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
    }
    .main {
      padding-top: 0.5rem;
    }
  }
</style>
