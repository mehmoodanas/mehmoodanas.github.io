---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/portfolio';
import { absoluteUrl, url } from '../utils/url';

interface Props {
  title: string;
  description?: string;
  /** Path to the social-sharing image (1200×630). */
  image?: string;
  /** Extra JSON-LD structured data for this page. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results and omit its canonical URL (used for the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = '/og-image.png',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://mehmoodanas.github.io');
const imageUrl = absoluteUrl(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#f6f5f2" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.toString()} />}
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <!-- Social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical.toString()} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`Card with the name ${site.name}, the line "${site.title}", and a decorative stack of three layers`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- Lets CSS know JavaScript is available (scroll reveals, mobile menu). -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div id="top"></div>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
